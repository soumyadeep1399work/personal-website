---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url } from '../../url';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { dateStyle: 'medium' });
---
<Base title="Blog" description="Writing on technology and leadership.">
  <section>
    <h1 class="page-title">Blog</h1>
    <p class="lead">Notes on building technology and leading the people who build it.</p>
    <ul class="posts">
      {posts.map((post) => (
        <li><a href={url(`/blog/${post.id}`)}>
          <span class="mono date">{fmt(post.data.date)}</span>
          <span class="pt">{post.data.title}</span>
          <span class="pd">{post.data.description}</span>
        </a></li>
      ))}
    </ul>
  </section>
</Base>
