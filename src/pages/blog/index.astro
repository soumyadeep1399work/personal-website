---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url } from '../../url';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Blog" description="Notes and writing.">
  <section>
    <h2>Blog</h2>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a class="card" href={url(`/blog/${post.id}`)}>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="post-meta">{post.data.date.toLocaleDateString('en-US', { dateStyle: 'long' })}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
