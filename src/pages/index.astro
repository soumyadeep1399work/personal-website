---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site } from '../site';
import { url } from '../url';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { dateStyle: 'medium' });
---
<Base>
  <section class="hero">
    <p class="eyebrow mono"><span class="prompt">$</span> {site.role.toLowerCase()}</p>
    <h1>{site.headline}</h1>
    <p class="lead">{site.intro}</p>
    <div class="badges">
      {site.tracks.map((t) => <span class={`badge ${t.id}`}>{t.label}</span>)}
    </div>
    <div class="actions">
      <a class="btn primary" href="#projects">See my work</a>
      <a class="btn" href="#contact">Get in touch</a>
    </div>
    <dl class="stats">
      {site.stats.map((s) => <div><dt>{s.value}</dt><dd>{s.label}</dd></div>)}
    </dl>
  </section>

  <section id="expertise">
    <h2><span class="mono hash">//</span> Two sides of the same job</h2>
    <div class="tracks">
      {site.tracks.map((t) => (
        <article class={`track ${t.id}`}>
          <p class="mono label">{t.label}</p>
          <h3>{t.blurb}</h3>
          <ul>{t.points.map((p) => <li>{p}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <section id="projects">
    <h2><span class="mono hash">//</span> Selected projects</h2>
    <div class="grid">
      {site.projects.map((p) => (
        <a class="card" href={p.href}>
          <span class={`badge small ${p.track.toLowerCase()}`}>{p.track}</span>
          <h3>{p.title}</h3>
          <p>{p.description}</p>
          <p class="mono tags">{p.tags.join(' · ')}</p>
        </a>
      ))}
    </div>
  </section>

  {posts.length > 0 && (
    <section id="writing">
      <h2><span class="mono hash">//</span> Latest writing</h2>
      <ul class="posts">
        {posts.map((post) => (
          <li><a href={url(`/blog/${post.id}`)}>
            <span class="mono date">{fmt(post.data.date)}</span>
            <span class="pt">{post.data.title}</span>
            <span class="pd">{post.data.description}</span>
          </a></li>
        ))}
      </ul>
      <p><a class="link" href={url('/blog')}>All posts →</a></p>
    </section>
  )}

  <section id="about">
    <h2><span class="mono hash">//</span> About</h2>
    <div class="about">{site.about.map((p) => <p>{p}</p>)}</div>
  </section>

  <section id="contact">
    <div class="contact">
      <h2><span class="mono hash">//</span> Let’s talk</h2>
      <p>Hiring, partnering, or just curious? I’d like to hear from you.</p>
      <div class="actions">
        <a class="btn primary" href={`mailto:${site.email}`}>{site.email}</a>
        {site.links.map((l) => <a class="btn" href={l.href}>{l.label}</a>)}
      </div>
    </div>
  </section>
</Base>
