---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site } from '../site';
import { url } from '../url';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<Base>
  <section class="hero">
    <h1>Hi, I'm <span>{site.name}</span>.</h1>
    <p class="lead">{site.tagline}</p>
    <p>{site.intro}</p>
    <a class="btn" href="#projects">See my work</a>
    <a class="btn alt" href="#contact">Get in touch</a>
  </section>

  <section id="about">
    <h2>About</h2>
    {site.about.map((p) => <p>{p}</p>)}
  </section>

  <section id="projects">
    <h2>Projects</h2>
    <div class="grid">
      {site.projects.map((p) => (
        <a class="card" href={p.href}>
          <h3>{p.title}</h3>
          <p>{p.description}</p>
          <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
        </a>
      ))}
    </div>
  </section>

  {posts.length > 0 && (
    <section id="writing">
      <h2>Latest writing</h2>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="card" href={url(`/blog/${post.id}`)}>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="post-meta">{post.data.date.toLocaleDateString('en-US', { dateStyle: 'long' })}</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="btn" href={url('/blog')}>All posts</a>
    </section>
  )}

  <section id="contact">
    <h2>Contact</h2>
    <p>Want to work together or just say hi?</p>
    <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
    <p>{site.links.map((l) => <a class="btn alt" href={l.href}>{l.label}</a>)}</p>
  </section>
</Base>
